# =============================================================================
# Platform — Environment Variables Reference
#
# Copy this file to /etc/platform/.env and fill in your values before running
# bootstrap.sh in NON_INTERACTIVE=true mode (CI/CD, repeated installs).
#
#   cp .env.example /etc/platform/.env
#   $EDITOR /etc/platform/.env
#   NON_INTERACTIVE=true sudo ./bootstrap.sh
#
# Every value below is optional in interactive mode — the script will prompt
# you for what it needs. In NON_INTERACTIVE mode, blanks are accepted (the
# integration is simply skipped).
# =============================================================================

# ── Server & Domain ──────────────────────────────────────────────────────────
DOMAIN=platform.yourcompany.com
ADMIN_EMAIL=admin@yourcompany.com
PLATFORM_NAME=Platform

# ── Bootstrap behaviour ──────────────────────────────────────────────────────
# Skip all interactive prompts (CI mode). Any missing values become empty.
NON_INTERACTIVE=false
# Use an existing Kubernetes cluster instead of installing k3s.
SKIP_K8S=false
# Skip the RAM/disk/port pre-flight check (not recommended).
SKIP_PREFLIGHT=false

# ── Container images ────────────────────────────────────────────────────────
# Change these only if running your own fork of the Platform.
# The default images are published from https://github.com/Mpratyush54/SERVER-automation
PLATFORM_IMAGE_REGISTRY=ghcr.io/mpratyush54
PLATFORM_IMAGE_TAG=latest
# Git URL used by ArgoCD for GitOps sync (leave as-is for stock deployments)
PLATFORM_REPO_URL=https://github.com/Mpratyush54/SERVER-automation

# ── Components to install ────────────────────────────────────────────────────
INSTALL_ARGOCD=y
INSTALL_MONITORING=y
INSTALL_PORTAINER=y
INSTALL_INFISICAL=y
INSTALL_CERTMANAGER=y

# ── Let's Encrypt ────────────────────────────────────────────────────────────
LE_EMAIL=admin@yourcompany.com

# ── Generated secrets (leave blank — bootstrap.sh generates them for you) ────
POSTGRES_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=
MINIO_ACCESS_KEY=platformadmin
MINIO_SECRET_KEY=
JWT_SECRET=
PLATFORM_WEBHOOK_SECRET=
ARGOCD_PASSWORD=
GRAFANA_PASSWORD=
INFISICAL_ENCRYPTION_KEY=
INFISICAL_JWT_SECRET=
PORTAINER_ADMIN_PASSWORD=

# ── GitHub Integration ───────────────────────────────────────────────────────
# Personal Access Token — scopes: repo, admin:org_hook, write:packages
GITHUB_TOKEN=
GITHUB_ORG=your-org
GITHUB_REGISTRY=ghcr.io
# Webhook URL after setup: https://DOMAIN/api/webhooks/github

# ── GitLab Integration ───────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.com
# Personal Access Token — scopes: api, read_repository
GITLAB_TOKEN=
GITLAB_GROUP=your-group
# Webhook URL after setup: https://DOMAIN/api/webhooks/gitlab

# ── ClickUp Integration ──────────────────────────────────────────────────────
# Found in: ClickUp → User Settings → Apps → Generate Token
CLICKUP_API_TOKEN=
# Found in workspace URL: app.clickup.com/TEAM_ID/...
CLICKUP_TEAM_ID=
# Default list for bug reports
CLICKUP_DEFAULT_LIST_ID=

# ── SMTP / Email Notifications ───────────────────────────────────────────────
# Provider: custom | ses | sendgrid | mailgun
SMTP_PROVIDER=
# Custom SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# AWS SES
SMTP_AWS_REGION=us-east-1
SMTP_AWS_KEY=
SMTP_AWS_SECRET=
# SendGrid
SENDGRID_API_KEY=
# Mailgun
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
# From address (all providers)
SMTP_FROM_EMAIL=noreply@yourcompany.com
SMTP_FROM_NAME=Platform

# ── External S3 / Backup Storage (optional — MinIO used if blank) ────────────
EXT_S3_ENDPOINT=
EXT_S3_BUCKET=platform-backups
EXT_S3_KEY=
EXT_S3_SECRET=
EXT_S3_REGION=us-east-1
