# syntax=docker/dockerfile:1
# Build context: repository root (needs docs/).
FROM --platform=$BUILDPLATFORM node:26.12.1-alpine3.24 AS builder
WORKDIR /app/platform/portal
COPY platform/portal/package*.json ./
# Reproducible install when a lockfile is committed; fall back until it is.
RUN if [ -f package-lock.json ]; then \
      npm ci --no-audit --no-fund; \
    else \
      echo "WARN: no package-lock.json, falling back to npm install" >&2; \
      npm install --no-audit --no-fund; \
    fi
COPY platform/portal/ .
COPY docs/ public/docs/
RUN npm run build:public
# The runtime runs nginx as an unprivileged user, which cannot bind :80.
RUN sed -i -E 's/^([[:space:]]*)listen[[:space:]]+80;/\1listen 8080;/' nginx.public.conf \
    && grep -q 'listen 8080;' nginx.public.conf

# Runtime: nginx as UID 101, listening on 8080.
FROM --platform=$TARGETPLATFORM nginxinc/nginx-unprivileged:1.30.6-alpine3.24
COPY --from=builder /app/platform/portal/dist/portal/browser /usr/share/nginx/html
COPY --from=builder /app/platform/portal/nginx.public.conf /etc/nginx/conf.d/default.conf
USER 101
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
