{
  "name": "portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/build-docs-search.mjs && ng serve",
    "build": "node scripts/build-docs-search.mjs && ng build",
    "build:public": "node scripts/build-docs-search.mjs && node scripts/version-public-media.mjs && ng build && node scripts/prerender-docs.mjs && node scripts/prerender-landing.mjs",
    "watch": "node scripts/build-docs-search.mjs && ng build --watch --configuration development",
    "test": "ng test",
    "test:docs": "ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.docs-spec.json --include=src/app/guards/docs.matcher.spec.ts --include=src/app/pages/docs/docs.component.spec.ts",
    "test:security": "ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.security-spec.json --include=src/app/pages/docs/docs-sanitize.spec.ts --include=src/app/services/auth.interceptor.spec.ts --include=src/app/guards/public-domain.guard.spec.ts --include=src/app/pages/iframe-view/iframe-view.component.spec.ts && node --test scripts/nginx-headers.test.mjs scripts/prerender-docs.test.mjs",
    "test:public": "ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.docs-spec.json --include=src/app/guards/home.guard.spec.ts --include=src/app/guards/docs.matcher.spec.ts --include=src/app/pages/docs/docs.component.spec.ts --include=src/app/pages/docs/docs-sanitize.spec.ts --include=src/app/pages/docs/docs-search.spec.ts --include=src/app/pages/docs/docs-search.component.spec.ts --include=src/app/pages/landing/landing.component.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "mermaid": "^12.3.0",
    "rrweb-player": "2.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.1",
    "jasmine-core": "~5.5.0",
    "jsdom": "^25.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "rrweb": "2.2.0",
    "rrdom": "2.2.0",
    "rrweb-snapshot": "2.2.0",
    "@rrweb/types": "2.2.0",
    "@rrweb/utils": "2.2.0",
    "@rrweb/replay": "2.2.0",
    "@rrweb/packer": "2.2.0"
  }
}
