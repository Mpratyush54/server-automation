{
  "name": "platform-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migration:generate": "npm run build && typeorm migration:generate -p -d dist/config/data-source.js",
    "migration:create": "typeorm migration:create",
    "migration:run": "npm run build && node dist/migrate.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/config/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/config/data-source.js",
    "migration:check": "npm run build && typeorm migration:generate --dryrun --check -d dist/config/data-source.js src/migrations/Drift",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest --forceExit --detectOpenHandles --testPathPattern=tests/unit",
    "test:integration": "jest --forceExit --detectOpenHandles --testPathPattern=tests/integration",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@kubernetes/client-node": "^1.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^130.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.1.4",
    "pg": "^8.11.0",
    "rate-limit-redis": "^4.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
